#!/usr/bin/env bash
# test: test/tmuxs.test.sh

# ---- pane 状態の書込側 (Claude hook 統合) --------------------------------
# settings.json が pane 内で `tmuxs waiting|running|idle|remove` を呼ぶ。
# waiting が 1 つでも発生したら status bar の待ち表示 (@tmuxs_waiting) に ⏳N を
# 点灯し、全 pane の waiting が解消したら消す。読取側と marker_dir() を共有する
# (旧 ~/.mo/.../tmux-pane-state.sh の二重定義を解消)。
# best-effort のため tmux 呼び出し失敗で Claude を止めないよう常に 0 で抜ける。
readonly waiting_color='#E5AF1E'
# readonly waiting_color='#4B607F'
# 黄色帯モード。1=ON: waiting 時に status bar 全体を黄色帯で強調 (tmux.conf の
# @tmuxs_band 条件配色と連動し文字は暗色に切替わる)。0=OFF: status-left の
# ⏳N インジケータのみ。
readonly band_enabled=1

# preview で各 pane を末尾空行を除いた最新何行に絞るかの既定値。
# fzf 実行時は FZF_PREVIEW_LINES から 3 pane 一望になるよう上書きする。
readonly preview_pane_lines=10

# ---- list のレイアウト定数 -----------------------------------------------
# fzf の preview が占める割合 (%)。残りが list 側の桁数になる。
# popup は端末の 90% (169 桁) なので、80% だと list が 33 桁しか残らず
# セッション名が切り詰められる。60% なら 65 桁前後を確保できる。
readonly preview_ratio=60
# fzf がリスト左端に常時確保するポインタ + マーカー列。
readonly fzf_gutter_cols=2
# セッション行の左端に置くマーク列の幅と、名前列と右列 (Nw Mp) の間隔。
# マーク列には .tasks.md の front matter の status をそのまま置き、
# 足りない分は同じ表示幅の空白を左に埋めて右詰めにする。
# 印は最大 2 つ (✅️ と 🚀) 並ぶので、絵文字 1 つ 2 桁 x 2 で 4 桁を確保する。
# 印の絵文字そのものは bin/tasks が決める。ここは値を運ぶだけで対応表を持たない。
readonly list_indent=4
readonly list_gap=2
# 印 1 つあたりの表示幅。status の文字数からでなく、含まれる印の個数から
# 空白の数を出す (✅️ は U+2705 + VS16 の 2 文字だが表示は 2 桁)。
readonly mark_cols=2
# 名前列をこれ以上は削らない下限。
readonly min_name_cols=8
# git 管理外のパスのセッションをまとめる見出し。
readonly no_repo_label='(no repo)'

# pane 状態マーカーの保存先。書込側 (hook イベント handle_event) と読取側
# (fzf list/preview) が本ファイル内でこの 1 関数を共有する (SSOT)。
# テストは TMUXS_MARKER_DIR で一時ディレクトリに上書きする。
# (旧 ~/.mo/.../tmux-pane-state.sh との二重定義は本統合で解消済み)
marker_dir() {
  printf '%s' "${TMUXS_MARKER_DIR:-${XDG_RUNTIME_DIR:-/tmp}/tmuxs}"
}

# 状態 -> SGR の 2 関数は行 / pane ごとに呼ばれる。コマンド置換で受けると
# その都度 fork するので nameref で返す (表示幅ユーティリティと同じ理由)。

# 状態名 -> リスト行用 ANSI SGR (背景色 + 前景色)。マーカー無し(none)は非ゼロ復帰。
state_sgr() {
  local -n _ss_out=$1
  case $2 in
    waiting) _ss_out='48;2;229;175;30;38;2;0;0;0' ;;
    running) _ss_out='48;2;121;148;120;38;2;255;255;255' ;;
    idle) _ss_out='48;2;78;78;78;38;2;255;255;255' ;;
    *) return 1 ;;
  esac
}

# 状態名 -> preview ヘッダ帯用 SGR (太字込み)。マーカー無しは従来の青背景。
band_sgr() {
  local -n _bs_out=$1
  case $2 in
    waiting) _bs_out='1;38;2;0;0;0;48;2;229;175;30' ;;
    running) _bs_out='1;38;2;255;255;255;48;2;121;148;120' ;;
    idle) _bs_out='1;38;2;255;255;255;48;2;78;78;78' ;;
    *) _bs_out='1;30;44' ;;
  esac
}

# 現存する全 pane_id を連想配列 (nameref) に集める。死んだ pane の判定に使う。
collect_alive_panes() {
  local -n _alive=$1
  local p
  while read -r p; do
    [[ -n $p ]] && _alive["$p"]=1
  done < <(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)
}

# 死んだ pane (現存しない pane_id) のマーカーを削除する。
cleanup_markers() {
  local dir
  dir=$(marker_dir)
  [[ -d $dir ]] || return 0
  local -A alive=()
  collect_alive_panes alive
  local f pid
  for f in "$dir"/*; do
    [[ -e $f ]] || continue
    pid=${f##*/}
    [[ -n ${alive[$pid]:-} ]] || rm -f "$f"
  done
}

# ---- 表示幅ユーティリティ ------------------------------------------------
# bash の ${#s} と printf の %-*s は文字数で数えるため、全角を含むセッション名では
# 桁が揃わない。表示幅 (端末カラム数) で数え直す。
# 戻り値をコマンド置換で返すと 1 文字ごとに fork するので nameref で返す。

# コードポイントが全角 (表示 2 桁) かを判定する。CJK・かな・ハングル・全角記号が対象。
is_wide_cp() {
  local cp=$1
  ((cp >= 0x1100 && cp <= 0x115F)) && return 0
  ((cp >= 0x2E80 && cp <= 0xA4CF)) && return 0
  ((cp >= 0xAC00 && cp <= 0xD7A3)) && return 0
  ((cp >= 0xF900 && cp <= 0xFAFF)) && return 0
  ((cp >= 0xFE30 && cp <= 0xFE6F)) && return 0
  ((cp >= 0xFF00 && cp <= 0xFF60)) && return 0
  ((cp >= 0xFFE0 && cp <= 0xFFE6)) && return 0
  ((cp >= 0x20000))
}

# 文字列の表示幅を nameref 引数へ返す。
# ASCII のみなら文字数がそのまま表示幅 (ほぼ全てのセッション名がこの経路)。
disp_width() {
  local -n _dw_out=$1
  local s=$2 i c cp add n=0
  if [[ $s != *[![:ascii:]]* ]]; then
    _dw_out=${#s}
    return 0
  fi
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    printf -v cp '%d' "'$c"
    add=1
    is_wide_cp "$cp" && add=2
    n=$((n + add))
  done
  _dw_out=$n
}

# 表示幅を width ちょうどに整える。超える分は切り詰めて末尾を '..' にし、
# 足りない分は右を空白で埋める。切り詰めと桁揃えは常に対で必要なので 1 関数にする
# (分けると同じ文字列を 2 度走査することになる)。
fit_disp() {
  local -n _fd_out=$1
  local s=$2 width=$3 w
  disp_width w "$s"
  if ((w > width)); then
    local i c cp add n=0 out=''
    for ((i = 0; i < ${#s}; i++)); do
      c=${s:i:1}
      printf -v cp '%d' "'$c"
      add=1
      is_wide_cp "$cp" && add=2
      ((n + add > width - 2)) && break
      out+=$c
      n=$((n + add))
    done
    s="${out}.."
    w=$((n + 2))
  fi
  local fill=$((width - w))
  ((fill < 0)) && fill=0
  printf -v _fd_out '%s%*s' "$s" "$fill" ''
}

# ---- list 本体 -----------------------------------------------------------

# 外から来た値を算術評価へ渡す前に数値化する。非数値は fallback。
# set -u 下では $((abc)) が unbound variable で落ち、算術式は
# コマンド置換も評価するため、環境変数は必ずここを通してから使う。
num_or() {
  local -n _no_out=$1
  _no_out=$3
  [[ $2 =~ ^[0-9]+$ ]] || return 0
  _no_out=$2
}

# 実行系 bind を transform で包み、見出し行 ({1} が空) では
# アクション列そのものを組み立てない = 完全な no-op にする。
# 移動側の transform を擦り抜けてカーソルが見出しに乗っても誤爆しない
# (マウスクリック・ホイールは移動 bind の対象外なので、この層が最終防衛線)。
guard_empty() {
  printf 'transform:if [ -n {1} ]; then echo "%s"; fi' "$1"
}

# fzf の list 側に使える桁数。端末幅から preview 分と fzf のポインタ列を除く。
# tty が無い場合 (パイプ実行・テスト) は 0 を返し、切り詰めなしで整形させる。
list_cols() {
  local size cols
  size=$(stty size 2>/dev/null) || size=''
  num_or cols "${size#* }" 0
  ((cols > 0)) || {
    printf '0'
    return 0
  }
  printf '%s' $((cols * (100 - preview_ratio) / 100 - fzf_gutter_cols))
}

# pane の作業パスから所属リポジトリ名と worktree ルートを求める。
# リポジトリ名は git 管理外なら空文字、ルートは bare / 管理外なら空文字。
# --git-common-dir は worktree でも親リポジトリの .git を指すため、
# worktree のセッションが親リポジトリのグループへ畳まれる。
# --show-toplevel は worktree ごとのルートを返すので .tasks.md の在処になる。
# bare では toplevel だけが失敗し stdout に common-dir の 1 行しか出ない。
# 終了コードで捨てず行数で見分ける (bare のグループ分けを壊さない)。
# git 呼び出しは path 単位で呼び出し元の rcache / tcache へメモ化する。
git_info_of_path() {
  local -n _gi_repo=$1 _gi_top=$2
  local path=$3 common
  _gi_repo=''
  _gi_top=''
  [[ -n $path ]] || return 0
  if [[ -z ${rcache[$path]+set} ]]; then
    local -a out=()
    mapfile -t out < <(git -C "$path" rev-parse --path-format=absolute \
      --git-common-dir --show-toplevel 2>/dev/null)
    common=${out[0]:-}
    common=${common%/}
    # 通常 repo / worktree は '<repo>/.git' なので 1 段上る。
    # submodule は '<super>/.git/modules/<sub>'、bare は '<repo>.git' で
    # 末尾が .git ではないため上ってはならない (それぞれ modules / 親ディレクトリ名になる)。
    [[ ${common##*/} == .git ]] && common=${common%/*}
    common=${common##*/}
    rcache[$path]=${common%.git}
    tcache[$path]=${out[1]:-}
  fi
  _gi_repo=${rcache[$path]}
  _gi_top=${tcache[$path]}
}

# worktree ルートの .tasks.md を読み front matter の status の値を nameref へ返す。
# .tasks.md は tasks store の index.md への symlink。front matter は先頭にあるので
# 閉じの `---` で読み終える (数百行の index.md 全体は読まない)。
# 親リポジトリの index.md には front matter が無く、その場合は空を返す。
task_status() {
  local -n _ts_out=$1
  local root=$2 file line first=1
  _ts_out=''
  [[ -n $root ]] || return 0
  file="$root/.tasks.md"
  [[ -f $file ]] || return 0
  while IFS= read -r line; do
    if ((first)); then
      first=0
      [[ $line == '---' ]] || return 0
      continue
    fi
    [[ $line == '---' ]] && return 0
    if [[ $line == status:* ]]; then
      line=${line#status:}
      # 前後の空白だけを落とす。値は絵文字なのでここでは中身を解釈しない
      _ts_out=${line#"${line%%[![:space:]]*}"}
      _ts_out=${_ts_out%"${_ts_out##*[![:space:]]}"}
      return 0
    fi
  done <"$file"
  return 0
}

# 全 pane を一度に列挙し、セッション単位の pane 数・代表状態・作業パスを集める
# (セッション単位の pane 総数 format は tmux に無い)。
# 状態の優先度: waiting(3) > running(2) > idle(1) > マーカー無し(0)。
# 作業パスは列挙順で最初の pane のものを採る。#{session_path} は tmux 3.7b では
# 別セッションのパスを返すことがあり、グループ判定に使えない。
collect_session_stats() {
  local dir
  dir=$(marker_dir)
  local s pid ppath st r
  while IFS=$'\t' read -r s pid ppath; do
    [[ -n $s ]] || continue
    pcount[$s]=$((${pcount[$s]:-0} + 1))
    [[ -n ${spath[$s]:-} ]] || spath[$s]=$ppath
    st=''
    [[ -f $dir/$pid ]] && st=$(<"$dir/$pid")
    case $st in
      waiting) r=3 ;;
      running) r=2 ;;
      idle) r=1 ;;
      *) r=0 ;;
    esac
    ((r > ${prank[$s]:-0})) && prank[$s]=$r
  done < <(tmux list-panes -a \
    -F '#{session_name}'$'\t''#{pane_id}'$'\t''#{pane_current_path}')
  return 0
}

# セッション一覧を tmux の列挙順で読み、右列 (Nw Mp と attach の *) を組み立てつつ
# リポジトリ名のグループへ振り分ける。pane 数・状態・作業パスは
# collect_session_stats が先に埋めてある。
# 群内は waiting のセッションを先頭へ寄せ、残りは tmux の列挙順を保つ。
collect_sessions() {
  local name nwin attached mark repo top st
  while IFS=$'\t' read -r name nwin attached; do
    [[ -n $name ]] || continue
    mark=''
    [[ -n $attached ]] && mark=' *'
    sright[$name]="${nwin}w${pcount[$name]:-0}p${mark}"
    git_info_of_path repo top "${spath[$name]:-}"
    task_status st "$top"
    sstatus[$name]=$st
    [[ -n $repo ]] || repo=$no_repo_label
    gcount[$repo]=$((${gcount[$repo]:-0} + 1))
    if ((${prank[$name]:-0} == 3)); then
      waiters[$repo]+="${name}"$'\n'
      continue
    fi
    others[$repo]+="${name}"$'\n'
  done < <(tmux list-sessions \
    -F $'#{session_name}\t#{session_windows}\t#{?session_attached,1,}')
  return 0
}

# グループの表示順を決める。waiting を含む群を最上位、git 管理外の群は末尾、
# 残りはセッション数の多い順で、同数はリポジトリ名の昇順。
# nkey (管理外か) はセッション数より優先する。後ろに置くと同数時のタイブレークに
# しかならず、管理外のセッションが多いときに git リポジトリ群より上へ浮く。
# ordered の各要素はソートキー付きで、末尾フィールドがリポジトリ名。
sort_groups() {
  local repo line wkey nkey
  local -a lines=()
  for repo in "${!gcount[@]}"; do
    wkey=1
    [[ -n ${waiters[$repo]:-} ]] && wkey=0
    nkey=0
    [[ $repo == "$no_repo_label" ]] && nkey=1
    printf -v line '%d\t%d\t%d\t%s' "$wkey" "${gcount[$repo]}" "$nkey" "$repo"
    lines+=("$line")
  done
  ((${#lines[@]})) || return 0
  mapfile -t ordered < <(printf '%s\n' "${lines[@]}" |
    LC_ALL=C sort -t$'\t' -k1,1n -k3,3n -k2,2nr -k4,4)
}

# 名前列と右列の幅を決める。list 幅が分かる場合は Nw Mp * が右端へ収まるよう
# 名前列を削る (最長名へ合わせるだけだと右列が画面外へ溢れる)。
calc_columns() {
  local name w rightw=0
  for name in "${!sright[@]}"; do
    disp_width w "$name"
    ((w > namew)) && namew=$w
    disp_width w "${sright[$name]}"
    ((w > rightw)) && rightw=$w
  done
  local cols
  num_or cols "${TMUXS_LIST_COLS:-0}" 0
  ((cols > 0)) || return 0
  local avail=$((cols - list_indent - list_gap - rightw))
  ((avail < min_name_cols)) && avail=$min_name_cols
  ((namew > avail)) && namew=$avail
  return 0
}

# status の印を左端のマーク列 (表示幅 list_indent) へ収めた文字列を nameref へ返す。
# 空白の数は文字数でなく印の個数から出す。%-*s も ${#s} も文字数で数えるので、
# 絵文字 (1 文字で 2 桁) や VS16 (2 文字目で 0 桁) が混ざると桁が合わない。
mark_pad() {
  local -n _mp_out=$1
  local status=$2 n=0 i
  for ((i = 0; i < ${#status}; i++)); do
    # VS16 (U+FE0F) は直前の絵文字の異体字セレクタで、単独では幅を持たない。
    # 目に見えない文字なのでエスケープで書く (リテラルだと編集で消えても気付けない)
    [[ ${status:i:1} == $'\ufe0f' ]] && continue
    # ((n++)) は n=0 のとき評価値 0 => 終了ステータス 1 で set -e に殺される
    n=$((n + 1))
  done
  # 想定より多い印や単語 (`status: in progress` 等) が来ても列幅を超えさせない。
  # %*s は幅が負だと左寄せ + 絶対値幅として効き、空白を減らすどころか増やす。
  # 印は捨てて空白で埋める: 桁が崩れると右列ごと画面外へ押し出される
  ((n * mark_cols > list_indent)) && {
    status=''
    n=0
  }
  printf -v _mp_out '%*s%s' $((list_indent - n * mark_cols)) '' "$status"
}

# セッション行を 1 行出力する。1 列目は fzf 用の隠しフィールド (素のセッション名)。
# 状態色は行全体を囲む前後の SGR として持ち、書式そのものは 1 本に保つ。
print_session_row() {
  local name=$1 shown sname sgr pre='' post='' pad
  fit_disp shown "$name" "$namew"
  case ${prank[$name]:-0} in
    3) sname=waiting ;;
    2) sname=running ;;
    1) sname=idle ;;
    *) sname='' ;;
  esac
  if state_sgr sgr "$sname"; then
    printf -v pre '\033[%sm' "$sgr"
    post=$'\033[0m'
  fi
  mark_pad pad "${sstatus[$name]:-}"
  printf '%s\t%s%s%s%*s%s%s\n' "$name" "$pre" \
    "$pad" "$shown" "$list_gap" '' "${sright[$name]}" "$post"
}

# 見出し行 + 配下セッション行を順に出力する。
# 見出し行は 1 列目 (fzf の {1}) を空にしてある。この「空 = 見出し」だけが
# fzf 側との契約で、キーボード移動は transform で見出しを飛ばし、
# 実行系 bind は guard_empty で空ターゲットなら何も組み立てない。
print_groups() {
  local entry repo name
  for entry in "${ordered[@]}"; do
    repo=${entry##*$'\t'}
    printf '\t\033[1m%s\033[0m\n' "$repo"
    while IFS= read -r name; do
      [[ -n $name ]] || continue
      print_session_row "$name"
    done <<<"${waiters[$repo]:-}${others[$repo]:-}"
  done
  return 0
}

# 全セッションをリポジトリ単位でグループ化して 1 行ずつ列挙する。
# 各行は "<hidden>\t<表示>" のタブ区切り。fzf は --with-nth=2 で表示側だけを見せ、
# {1} で素のセッション名 (preview / kill / switch のターゲット) を取る。
list_sessions() {
  local -A pcount=() prank=() spath=() rcache=() tcache=() \
  gcount=() waiters=() others=() sright=() sstatus=()
  local -a ordered=()
  local namew=0

  collect_session_stats
  collect_sessions
  sort_groups
  calc_columns
  print_groups
}

# 現存する pane のうち waiting マーカーを持つ数を数える。
# 死んだ pane のマーカーは無視する (誤って waiting 扱いしない)。
count_waiting() {
  local dir n=0
  dir=$(marker_dir)
  if [[ -d $dir ]]; then
    local -A alive=()
    collect_alive_panes alive
    local f pid
    for f in "$dir"/*; do
      [[ -e $f ]] || continue
      pid=${f##*/}
      [[ -n ${alive[$pid]:-} ]] || continue
      [[ $(<"$f") == waiting ]] && n=$((n + 1))
    done
  fi
  printf '%s' "$n"
}

# 黄色帯 ON: 現在の status-style を退避してから 黄/黒 へ直接上書きし、フラグ @tmuxs_band を立てる。
# status-style は style option で format 非展開のため tmux.conf の #{?...} では制御できず直接 set する。
# 退避済み判定は番兵 @tmuxs_band の有無で行い、二重上書きで黄色を「通常」と誤退避しないようにする。
# (conf 未リロードでも自己完結で復元できる。通常配色を hook にハードコードしない)
# 注意: 複数 pane がほぼ同時に band 突入すると show->set 非アトミックで後発が黄色を誤退避する
# レースがあるが、低頻度かつ best-effort のため未防御。
# status-left/right は文字列 option なので @tmuxs_band 条件で文字色が追従する。
band_on() {
  [[ $(tmux show -gv @tmuxs_band 2>/dev/null) == 1 ]] ||
    tmux set -g @tmuxs_status_saved "$(tmux show -gv status-style)"
  tmux set -g @tmuxs_band 1
  # 末尾に default を付けると tmux style 構文で bg/fg が端末デフォルトへリセットされ
  # 黄色帯が一切描画されない。色のみ指定する (status-style 基底に余分な属性は元々無い)。
  tmux set -g status-style "bg=${waiting_color},fg=#000000"
}

# 黄色帯 OFF: band 中なら退避値から status-style を復元し、番兵・退避値を unset する。
band_off() {
  [[ $(tmux show -gv @tmuxs_band 2>/dev/null) == 1 ]] || return 0
  tmux set -g status-style "$(tmux show -gv @tmuxs_status_saved)"
  tmux set -gu @tmuxs_status_saved
  tmux set -gu @tmuxs_band
}

# 待ち表示枠 (@tmuxs_waiting) と黄色帯を更新する。
# 入力待ち pane があれば status-left の ⏳N を点灯し、band_enabled=1 なら黄色帯も点灯。
# 無ければ消灯。同時 waiting でカウントが一時的にずれても次イベントで上書き整合する。
update_indicator() {
  local n
  n=$(count_waiting)
  if ((n > 0)); then
    # 黄色帯 ON 時は帯の上で読めるよう ⏳ を暗色、OFF 時は通常背景で映える黄色。
    local icon_color="$waiting_color"
    ((band_enabled)) && icon_color='#000000'
    tmux set -g @tmuxs_waiting "#[fg=${icon_color},bold]⏳${n} #[default]"
    ((band_enabled)) && band_on
    return
  fi
  tmux set -gu @tmuxs_waiting
  band_off
}

# state に応じて pane マーカーを更新する。remove は削除し、それ以外は内容を書き込む。
write_marker() {
  local state=$1 dir=$2 file=$3
  if [[ $state == remove ]]; then
    rm -f "$file"
    return
  fi
  mkdir -p "$dir"
  printf '%s' "$state" >"$file"
}

# hook イベント本体。tmux 外 (TMUX_PANE / TMUX 未設定) では何もせず戻る。
# best-effort のため set -e を効かせず、呼び出し元が exit 0 する。
handle_event() {
  [[ -n ${TMUX_PANE:-} && -n ${TMUX:-} ]] || return 0

  local state=$1 dir file old=''
  dir=$(marker_dir)
  file="${dir}/${TMUX_PANE}"
  [[ -f $file ]] && old=$(<"$file")

  write_marker "$state" "$dir" "$file"

  # 待ち表示の再計算は waiting が絡む遷移時のみ (running 連発時の tmux IPC 抑制)。
  if [[ $old == waiting || $state == waiting ]]; then
    update_indicator
  fi
  return 0
}

# ---- 手動確認ツール (`tmuxs __test-event`) -------------------------------
# 現在の pane を指定状態にし (本物のイベント処理 handle_event をそのまま呼ぶ)、
# 結果のマーカー/tmux option を表示する。状態設定ロジックは複製せず本体関数を再利用。
#   tmuxs __test-event waiting|running|idle|remove  # 状態を設定し結果表示
#   tmuxs __test-event status                       # 現状表示のみ (副作用なし)
#   tmuxs __test-event                              # fzf で選択
# tmux 外 (TMUX / TMUX_PANE 未設定) はエラーで抜ける。

# 現在の pane の状態 (マーカー内容・関連 tmux option・全 marker) を表示する。
show_state() {
  local dir file
  dir=$(marker_dir)
  file="${dir}/${TMUX_PANE}"

  printf '== pane %s state ==\n' "${TMUX_PANE}"
  printf 'marker 内容    : %s\n' "$([[ -f $file ]] && cat "$file" || printf '(none)')"
  printf '@tmuxs_waiting : %s\n' "$(tmux show -gv @tmuxs_waiting 2>/dev/null || true)"
  printf '@tmuxs_band    : %s\n' "$(tmux show -gv @tmuxs_band 2>/dev/null || true)"
  printf 'status-style   : %s\n' "$(tmux show -gv status-style 2>/dev/null || true)"
  printf '全 marker リスト (%s):\n' "${dir}"
  if [[ ! -d $dir ]]; then
    printf '  (dir なし)\n'
    return
  fi
  local f found=0
  for f in "${dir}"/*; do
    [[ -e $f ]] || break
    found=1
    printf '  %s = %s\n' "${f##*/}" "$(cat "$f")"
  done
  ((found)) || printf '  (empty)\n'
}

test_event() {
  set -euo pipefail
  [[ -n ${TMUX_PANE:-} && -n ${TMUX:-} ]] ||
    {
      printf 'error: tmux 外では実行できない (TMUX / TMUX_PANE 未設定)\n' >&2
      exit 1
    }

  local status=${1:-}
  [[ -n $status ]] || status=$(printf '%s\n' waiting running idle remove status |
    fzf --prompt='tmux-pane-state > ' --height=40% --reverse) ||
    {
      printf 'error: cancelled\n' >&2
      exit 1
    }

  case "${status}" in
    waiting | running | idle | remove) handle_event "${status}" ;;
    status) ;; # 現状表示のみ (副作用なし)
    *)
      printf 'error: unknown status: %s (waiting|running|idle|remove|status)\n' \
        "${status}" >&2
      exit 1
      ;;
  esac

  show_state
}

main() {
  case "${1:-}" in
    waiting | running | idle | remove)
      # Claude hook エントリ。best-effort のため tmux 失敗でも常に 0 で抜ける。
      handle_event "$1"
      exit 0
      ;;
    __test-event)
      shift
      test_event "$@"
      exit
      ;;
  esac

  set -euo pipefail

  case "${1:-}" in
    __kill)
      shift
      # target ("<session>:<window_index>") が属するセッションを安全に kill する。
      # 対象が現在 client のセッションなら、別セッションへ switch してから kill し、
      # 端末が detach されないようにする。
      local target=${1:-}
      [[ -n $target ]] || exit 0
      local session=${target%:*}
      local current
      current=$(tmux display-message -p '#{session_name}')
      if [[ $session == "$current" ]]; then
        local other
        other=$(tmux list-sessions -F '#{session_name}' |
          grep -vFx "$session" | head -n1 || true)
        if [[ -n $other ]]; then
          tmux switch-client -t "$other"
        fi
      fi
      tmux kill-session -t "$session"
      ;;
    __list) list_sessions ;;
    __cleanup) cleanup_markers ;;
    __new)
      # 新しいセッションを detached で作成し (名前は tmux 自動採番)、
      # 作成したセッションへ switch-client する。呼び出し元 fzf 側で accept して抜ける。
      local name
      name=$(tmux new-session -dP -F '#{session_name}')
      tmux switch-client -t "$name"
      ;;
    __switch)
      shift
      # 選択セッションへ switch する。waiting pane があればそこへ focus を移して
      # attach し、無ければ focus を動かさず last-active pane を維持する。
      # 複数 waiting があれば列挙順 (window->pane index) で最初を採用。
      local target=${1:-} session mdir
      [[ -n $target ]] || exit 0
      session=${target%:*}
      mdir=$(marker_dir)

      local waitwidx='' waitpid='' widx pid
      while IFS=$'\t' read -r widx pid; do
        [[ -n $pid ]] || continue
        [[ -f $mdir/$pid && $(<"$mdir/$pid") == waiting ]] || continue
        waitwidx=$widx
        waitpid=$pid
        break
      done < <(tmux list-panes -s -t "$session" \
        -F $'#{window_index}\t#{pane_id}')

      tmux switch-client -t "$session"
      [[ -n $waitpid ]] || return 0
      tmux select-window -t "$session:$waitwidx"
      tmux select-pane -t "$waitpid"
      ;;
    __preview)
      shift
      # 選択行 ("<session_name>") が属するセッションの全 window×pane を縦に積んで表示する。
      # ヘッダは tmux のタブ選択色(青背景・黒太字)で横幅いっぱいに塗る (各 window の active pane に *)。
      # 末尾空行を除いた最新 cap 行に各 pane を絞る。1 画面に最大 3 pane を収めるが、
      # pane 数が 3 未満ならその数で割り、少ない pane のときに高さを余らせない。
      local target=${1:-} session cols cap divisor mdir
      [[ -n $target ]] || exit 0
      session=${target%:*}
      cols=${FZF_PREVIEW_COLUMNS:-80}
      mdir=$(marker_dir)

      local -a panes
      mapfile -t panes < <(tmux list-panes -s -t "$session" \
        -F $'#{pane_active}\t#{window_index}\t#{pane_index}\t#{window_name}\t#{pane_current_command}\t#{pane_id}\t#{pane_current_path}')

      divisor=${#panes[@]}
      ((divisor > 3)) && divisor=3
      ((divisor < 1)) && divisor=1
      local plines
      num_or plines "${FZF_PREVIEW_LINES:-}" 0
      cap=$preview_pane_lines
      ((plines > 0)) && cap=$((plines / divisor - 2))
      ((cap < 3)) && cap=3

      local line active widx pidx wname cmd pid path dir mark st band
      for line in "${panes[@]}"; do
        IFS=$'\t' read -r active widx pidx wname cmd pid path <<<"$line"
        mark=''
        [[ $active == 1 ]] && mark=' *'
        dir=${path##*/}
        [[ -z $dir ]] && dir=/
        st=''
        [[ -f $mdir/$pid ]] && st=$(<"$mdir/$pid")
        band_sgr band "$st"
        printf '\033[%sm%-*s\033[0m\n' "$band" "$cols" \
          "$session: win=$wname / $widx.$pidx $cmd [$dir]$mark"
        tmux capture-pane -ep -t "$pid" 2>/dev/null |
          awk -v n="$cap" '
            { buf[NR] = $0; if ($0 ~ /[^[:space:]]/) last = NR }
            END {
              start = last - n + 1
              if (start < 1) start = 1
              for (i = start; i <= last; i++) print buf[i]
            }'
        printf '\n'
      done
      ;;
    __rename)
      shift
      # 選択中セッションの名前を対話的に変更する。
      # fzf の execute() は端末を明け渡すので read でプロンプトを出せる。
      # fzf 実行中はカーソル非表示なので明示再表示し、前回プロンプトの残骸を
      # 消すため画面をクリアする。read -e で readline 行編集 (inputrc が vi なら
      # vi バインド)、-i で現在名をプリフィルする。
      local target=${1:-}
      [[ -n $target ]] || exit 0
      local session=${target%:*}
      local new
      printf '\033[2J\033[3J\033[H\033[?25h'
      read -er -p "Rename to: " -i "$session" new || true
      [[ -n $new && $new != "$session" ]] && tmux rename-session -t "$session" "$new"
      ;;
    *)
      local self
      self=$(realpath "$0")
      cleanup_markers
      # 整形に使う list 幅を子プロセスへ渡す。reload で __list を再実行するときも
      # 同じ幅で揃える必要がある (FZF_COLUMNS は start 時点では 0 で当てにならない)。
      # lint-ignore: uppercase tmuxs / tmux が読む env 名は呼ばれる側が決める
      TMUXS_LIST_COLS=$(list_cols)
      export TMUXS_LIST_COLS
      # --with-nth=2 で表示は 2 列目 (インデント済みの見出し / セッション行) だけにし、
      # {1} には素のセッション名が入る。見出し行は {1} が空。
      # 移動キーは全て transform で包み、見出しに乗ったらもう一歩進めて
      # カーソルをセッション行にしか置かない (先頭が見出しの場合は load で送る)。
      # 先頭行まで戻ったときだけ ({n} が 0) 進む向きへ折り返す。
      # 1 つでも掛け忘れると見出しに乗れてしまうので、判定は 2 つの文字列に閉じ込め、
      # 移動キーの一覧を回して bind を生成する。
      local skip_fwd='transform:[ -n {1} ] || echo down'
      local skip_back='transform:[ -n {1} ] || if [ {n} -eq 0 ]; then echo down; else echo up; fi'
      local -a bind_args=(--bind "load:${skip_fwd}")
      local key
      for key in j down ctrl-n ctrl-j; do
        bind_args+=(--bind "${key}:down+${skip_fwd}")
      done
      for key in k up ctrl-p ctrl-k; do
        bind_args+=(--bind "${key}:up+${skip_back}")
      done
      bind_args+=(--bind "page-down:page-down+${skip_fwd}")
      bind_args+=(--bind "page-up:page-up+${skip_back}")

      list_sessions |
        fzf --reverse --no-input --ansi \
          --delimiter=$'\t' --with-nth=2 \
          --preview "$self __preview {1}" \
          --preview-window "right:${preview_ratio}%" \
          "${bind_args[@]}" \
          --bind 'q:abort' \
          --bind 'J:preview-down,K:preview-up' \
          --bind "n:execute($self __new)+accept" \
          --bind "enter:$(guard_empty "execute($self __switch {1})+accept")" \
          --bind "r:$(guard_empty "execute($self __rename {1})+reload($self __list)")" \
          --bind "x:$(guard_empty "execute-silent($self __kill {1})+reload($self __list)")"
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
